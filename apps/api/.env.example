# H3 Studio 后端配置模板：复制成 apps/api/.env 后按本机改（.env 已被 gitignore）
# 全部变量都以 H3_ 为前缀，字段定义见 apps/api/app/config.py
# 例外：H3_HOME（可写数据根）只认真实环境变量，写在这里不生效 —— 它要在找到本文件之前就定下来。

# 数据库连接串。留空 = 无库模式：只有实例客户端，队列 / 用户 / agent token 都不可用。
# 用 apps/api/scripts/pg.py boot 起内嵌 PG 时，这一行会被自动覆写（端口是动态分配的，别手改）。
H3_DATABASE_URL=postgresql+asyncpg://h3:h3-dev-local-only@127.0.0.1:5432/h3studio

# 监听地址。改成非环回会打印警告：给智能体接入请走 MCP（h3 expose），别直接开 REST 本体。
H3_HOST=127.0.0.1
H3_PORT=8788

# 媒体与临时目录。「设置 → 系统」里改的目录存进数据库（app_settings['paths']），不回写本文件，
# 媒体/临时要重启后端才换、ffmpeg 存完立刻生效。这两行是「界面上没存过」时后端用的默认值。
# 相对路径按后端工作目录解析——h3 serve / uvicorn 都在 apps/api/ 下起，所以 ../../ 就是仓库根。
H3_MEDIA_ROOT=../../data/media
H3_TMP_ROOT=../../data/tmp

# 无库模式的实例引导文件；建表后权威来源是数据库 gen_instances
H3_INSTANCES_FILE=instances.dev.json

# JWT 会话密钥。留空则首次启动自动生成 .secret-jwt_key.txt；
# 给了但不足 32 字节会直接拒绝启动（HS256 的最低要求）。
H3_JWT_SECRET=
H3_JWT_TTL_S=900
H3_REFRESH_TTL_S=2592000

# 显存闸门：空闲不足这么多 GB 就不提交出图/出片任务
H3_MIN_FREE_VRAM_GB=12.0

# 单卡仲裁：本地实例开跑前先把文本模型进程让开（详见 app/gpu_arbiter.py）
H3_GPU_ARBITER=true

# 生成回收站：软删的版本满这么多天才真删文件
H3_TRASH_RETENTION_DAYS=100
H3_TRASH_PURGE_INTERVAL_S=21600
H3_TRASH_PURGE_LIMIT=500

# 备份建议要用 pg_dump：内嵌 pgserver 自带一份；装了独立 PostgreSQL 的机器上给绝对路径
# H3_PG_DUMP_PATH=C:/Program Files/PostgreSQL/17/bin/pg_dump.exe

# ComfyUI 轮询与 WS 重连退避
H3_COMFY_POLL_INTERVAL_S=2.0
H3_WS_BACKOFF_MAX_S=30.0

H3_LOG_LEVEL=INFO
