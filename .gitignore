# 依赖与虚拟环境
node_modules/
.venv/
# 打包专用环境（pgserver 只有 cp312 轮子，不能复用 apps/api/.venv）
.packaging/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 构建产物
dist/
build/
*.tsbuildinfo
*.egg-info/

# 本地数据与生成物（含 pgdata、媒体产物、导出、下载、临时）
data/
.downloads/
.scratch/
.tooling-pg/

# 外部安装与参考仓库（体积大 / 第三方，不入库）
comfyui/
reference/

# 密钥与环境（绝不入库）
.env
.env.*
!.env.example
*.key
.secret*
apps/api/.secret-jwt_key.txt

# 日志
*.log
*.out

# 编辑器 / 操作系统
.DS_Store
Thumbs.db

# Qoder：本项目本地的 MCP 配置（h3 mcp install 的默认落点，含本机绝对路径）
.qoder/settings.local.json
.idea/
.vscode/
