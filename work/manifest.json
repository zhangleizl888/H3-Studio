  "builtinWorkflows": [
    {
      "id": "builtin:qwen_image",
      "name": "Qwen-Image 出图",
      "taskKind": "image",
      "definedIn": "apps/api/app/gen/builtin_graphs.py + templates.py",
      "packaged": false,
      "note": "由后端代码按模板生成，不落 JSON 文件。权重按归一化模糊匹配自动挑：unet=qwen_image_2.1_int8_convrot（回落 bf16）／clip=qwen3vl_8b*／vae=qwen_image_2.1_vae*。"
    },
    {
      "id": "builtin:h3_video",
      "name": "MiniMax H3 出片",
      "taskKind": "video",
      "definedIn": "apps/api/app/gen/builtin_graphs.py + templates.py",
      "packaged": false,
      "note": "t2v / i2v / fl2v 三合一。unet=MiniMax_H3_FL2VA 或 Ref2VA_pruned_int8_convrot，clip=qwen3vl_32b_minimax_h3_int8_convrot，vae=minimax_h3_video_vae_fp16 + minimax_h3_audio_vae_fp32，turbo lora 有则加。"
    },
    {
      "id": "builtin:h3_chain",
      "name": "MiniMax H3 长片续拍",
      "taskKind": "video",
      "definedIn": "apps/api/app/gen/builtin_graphs.py（CHAIN_NODE=H3SeamlessChainSampler）",
      "packaged": false,
      "requiresCustomNode": "ComfyUI-minimaxH3-SequenceForge",
      "note": "段间引导无缝续拍。少了这个节点包，只有长片功能不可用，逐镜头出片不受影响。"
    }
  ],
